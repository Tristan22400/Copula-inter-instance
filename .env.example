# Template for the git-ignored .env read by copula_inter.credentials.
#   cp .env.example .env && chmod 600 .env
# then fill in the values. Never commit .env; the loader refuses it unless it is mode 600.
# Alternatives: export the variable, or put the bare value in ~/.config/copula-inter/<file>.

# PriorLabs API key with the TabPFN-3.5 licence accepted (https://ux.priorlabs.ai).
# Also read from ~/.config/copula-inter/tabpfn_token (or the legacy ~/.config/tabpfn_token).
TABPFN_TOKEN=

# Path to the SSH private key used for Grid5000 (the key itself stays in ~/.ssh).
# Also read from ~/.config/copula-inter/ssh_key_path.
COPULA_SSH_KEY=~/.ssh/id_ed25519
