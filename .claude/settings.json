{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_python.sh",
            "timeout": 90,
            "statusMessage": "ruff format + lint, mypy on changed lines..."
          }
        ]
      }
    ]
  }
}
